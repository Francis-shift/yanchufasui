# 复制为 .env.local 后填写（.env.local 不会提交到仓库）。部署平台上在"环境变量"里填同样的名字。
# 火山方舟的 API Key（本人自己填，不要发给任何人、不要写进代码）
ARK_API_KEY=
# 模型名或推理接入点 ID，例如豆包或 DeepSeek（只用不带深度思考的模式）
ARK_MODEL=
# 可选
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 模型不支持关闭思考参数时设为 0
ARK_DISABLE_THINKING=1
# 防刷：每个来源每分钟次数、每天总次数
RATE_PER_MINUTE=12
DAILY_CALL_CAP=2000
