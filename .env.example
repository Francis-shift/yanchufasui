# 复制为 .env.local 后填写（.env.local 不会提交到仓库）。部署平台上在"环境变量"里填同样的名字。
# 火山方舟的 API Key（本人自己填，不要发给任何人、不要写进代码）
ARK_API_KEY=
# 模型名或推理接入点 ID，例如豆包或 DeepSeek（只用不带深度思考的模式）
ARK_MODEL=
# 可选
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 模型不支持关闭思考参数时设为 0
ARK_DISABLE_THINKING=1
# 只给本机测速、评测脚本（tools/bench-parse.mjs、tools/eval-parse.mjs）用：要对比的多个接入点，逗号分隔；部署平台上不用填
ARK_MODELS=
# 语音识别（火山引擎"录音文件识别大模型·极速版"，本人自己填）：新版控制台给的 API Key 填 ASR_API_KEY；
# 旧版控制台给的是 APP ID 与 Access Token，填下面两个。都不填也能玩（麦克风按钮提示先打字）
ASR_API_KEY=
ASR_APP_ID=
ASR_ACCESS_TOKEN=
# 可选：识别服务的资源编号（默认极速版 volc.bigasr.auc_turbo）
ASR_RESOURCE_ID=
# 防刷：每个来源每分钟次数、每天总次数（解析、求灵感、语音识别合计）
RATE_PER_MINUTE=12
DAILY_CALL_CAP=2000
